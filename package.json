{
  "name": "tapscape",
  "private": true,
  "description": "A daily geography game for the Old School RuneScape world map.",
  "license": "MIT",
  "homepage": "https://tapscape.andrewhathaway.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewhathaway/TapScape.git"
  },
  "bugs": {
    "url": "https://github.com/andrewhathaway/TapScape/issues"
  },
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --test-scheduled",
    "db:migrate:local": "wrangler d1 migrations apply tapscape-reminders --local",
    "db:migrate": "wrangler d1 migrations apply tapscape-reminders --remote",
    "icons": "node scripts/build-icons.mjs",
    "pages": "node scripts/build-pages.mjs",
    "build": "tsc -b && tsc -p worker && vite build && node scripts/build-pages.mjs",
    "preview": "vite preview",
    "data:locations": "node scripts/build-locations.mjs",
    "data:map-version": "node scripts/refresh-map-version.mjs",
    "deploy": "npm run build && wrangler deploy",
    "preview:cf": "npm run build && wrangler dev",
    "smoke": "node scripts/smoke.mjs",
    "test:schedule": "node worker/schedule.test.ts"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "leaflet": "^1.9.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261012.1",
    "@types/leaflet": "^1.9.12",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.63.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wrangler": "^4.147.0"
  }
}
