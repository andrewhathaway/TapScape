{
  "name": "tapscape",
  "private": true,
  "description": "A daily geography game for the Old School RuneScape world map.",
  "license": "MIT",
  "homepage": "https://tapscape.andrewhathaway.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewhathaway/TapScape.git"
  },
  "bugs": {
    "url": "https://github.com/andrewhathaway/TapScape/issues"
  },
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "data:locations": "node scripts/build-locations.mjs",
    "data:map-version": "node scripts/refresh-map-version.mjs",
    "deploy": "npm run build && wrangler deploy",
    "preview:cf": "npm run build && wrangler dev",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.63.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wrangler": "^4.147.0"
  }
}
