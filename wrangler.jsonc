{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tapscape",
  "compatibility_date": "2026-10-01",

  // The Worker handles the API and the share pages; Cloudflare serves everything
  // else straight from ./dist without invoking it. /__scheduled is wrangler dev's way of
  // firing the cron by hand (`npm run dev:worker`, then GET /__scheduled); in
  // production it is just a 404 from the Worker.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The app has no client-side routes (deep links are query strings), so an
    // unknown path is a real 404 rather than a soft one that search engines penalise.
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/r/*", "/c/*", "/og/*", "/__scheduled"]
  },

  // The share-card font is bundled as raw bytes; .wasm needs no rule.
  "rules": [{ "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }],

  // Hourly, on the hour. Each run sends to subscribers whose local reminder
  // hour has just arrived (see worker/schedule.ts).
  "triggers": {
    "crons": ["0 * * * *"]
  },

  // Push subscriptions. Create the database once with
  //   npx wrangler d1 create tapscape-reminders
  // and paste the id it prints over the placeholder below. Local dev ignores
  // the id and uses a Miniflare database under .wrangler/.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tapscape-reminders",
      "database_id": "71dae859-501c-479c-ba53-0426128a46c4",
      "migrations_dir": "migrations"
    }
  ],

  // VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY and VAPID_SUBJECT are secrets:
  //   node scripts/vapid-keys.mjs
  //   npx wrangler secret put VAPID_PUBLIC_KEY   (and the other two)
  // Locally they come from .dev.vars, which is gitignored.

  // custom_domain creates and manages the DNS record for the subdomain, so this
  // never touches the apex route that serves the Astro site.
  "routes": [
    {
      "pattern": "tapscape.andrewhathaway.net",
      "custom_domain": true
    }
  ]
}
